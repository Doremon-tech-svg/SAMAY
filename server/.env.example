# Local Docker/Postgres. For Render, use the database's External URL (not the internal hostname).
DATABASE_URL=postgres://samay:samay@localhost:5432/samay
PORT=4000
DEMO_MODE=0
# --- LLM providers (free tiers) ---
# Google Gemini — get key at https://aistudio.google.com/app/apikey (free, no billing needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Groq — get key at https://console.groq.com/keys (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Bhashini / ULCA translation. Keep these server-side; never expose them in the browser.
# BHASHINI_USER_ID=your-ulca-user-id
# BHASHINI_UDYAT_KEY=your-udyat-key
# BHASHINI_INFERENCE_API_KEY=your-inference-key
# BHASHINI_TRANSLATION_SERVICE_ID=bhashini/iiith/nmt-all
# BHASHINI_PIPELINE_ID=actual-pipeline-id-from-developer-documentation
